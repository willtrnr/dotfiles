{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "empero-ai/Qwythos-9B-v2",
  "provider": {
    "local": {
      "name": "Local",
      "options": {
        "baseURL": "http://localhost:12434/v1",
        "apiKey": "sk-none"
      },
      "models": {
        "empero-ai/Qwythos-9B-v2": {
          "name": "Qwythos 9B v2",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 196608,
            "output": 16384
          }
        },
        "empero-ai/Qwythos-27B-v1": {
          "name": "Qwythos 27B v1",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "empero-ai/Qwen3.8-9B-Distill": {
          "name": "Qwen3.8 9B Distill",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 196608,
            "output": 16384
          }
        },
        "Jackrong/Qwopus3.5-9B-Coder": {
          "name": "Qwopus3.5 9B Coder",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "Jackrong/Qwopus3.5-4B-Coder": {
          "name": "Qwopus3.5 4B Coder",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 32768,
            "output": 16384
          }
        }
      }
    }
  },
  "enabled_providers": [
    "local"
  ],
  "lsp": true,
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Select-Object *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "Where-Object *": "allow",
      "cargo doc *": "allow",
      "cargo expand *": "allow",
      "cargo metadata *": "allow",
      "cargo search *": "allow",
      "cat *": "allow",
      "cp *": "ask",
      "cut *": "allow",
      "date": "allow",
      "df *": "allow",
      "dir *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "false": "allow",
      "find *": "allow",
      "free *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "mv *": "ask",
      "npm search *": "allow",
      "read *": "allow",
      "rm *": "ask",
      "rustc *": "allow",
      "rustdoc *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "true": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "where *": "allow",
      "which *": "allow",
      "whoami": "allow"
    },
    "doom_loop": "deny",
    "edit": "ask",
    "excel_get_workbook_metadata": "allow",
    "excel_read_data_from_excel": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "read": "allow",
    "semantic_search": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "indexing": {
    "enabled": false,
    "provider": "openai-compatible",
    "model": "nomic-ai/nomic-embed-text-v1.5",
    "openai-compatible": {
      "baseUrl": "http://localhost:12434/v1",
      "apiKey": "sk-none"
    },
    "vectorStore": "lancedb",
    "dimension": 768
  },
  "mcp": {
    "excel": {
      "type": "local",
      "command": [
        "uvx",
        "-q",
        "excel-mcp-server",
        "stdio"
      ],
      "enabled": false
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": false
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": false
    }
  }
}
