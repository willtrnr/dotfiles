{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/meituan/longcat-2.5",
  "small_model": "kilo/google/gemma-3-4b-it",
  "provider": {
    "local": {
      "name": "Local",
      "options": {
        "baseURL": "http://localhost:12434/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "DavidAU/Qwen3.8-27B-TURBO-Fable-Cold-Fusion-735-882-Heretic-Uncensored-NEO-CODER-MAX-MTP": {
          "name": "Qwen3.8 27B TURBO Fable Cold Fusion 735 882 Heretic Uncensored NEO CODER MAX MTP",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "empero-ai/Qwen3.8-9B-Distill": {
          "name": "Qwen3.8 9B Distill",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "google/gemma-4-12B-it": {
          "name": "gemma 4 12B it",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 229376,
            "output": 16384
          }
        },
        "google/gemma-4-26B-A4B-it": {
          "name": "gemma 4 26B A4B it",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "nvidia/NVIDIA-Nemotron-3-Nano-4B": {
          "name": "NVIDIA Nemotron 3 Nano 4B",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "poolside/Laguna-XS-2.1": {
          "name": "Laguna XS 2.1",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "network": "allow",
    "writable_paths": [
      "/tmp",
      "{env:HOME}/.cache",
      "{env:HOME}/.dotnet",
      "{env:HOME}/.ivy2",
      "{env:HOME}/.local/share/cargo",
      "{env:HOME}/.local/share/rustup/toolchains/*",
      "{env:HOME}/.sbt",
      "{env:HOME}/go"
    ]
  },
  "lsp": true,
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "Convert-FromJson *": "allow",
      "ForEach-Object *": "allow",
      "Format-Table *": "allow",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Join-Path *": "allow",
      "Measure-Object *": "allow",
      "Select-Object *": "allow",
      "Select-String *": "allow",
      "Sort-Object *": "allow",
      "Test-Path *": "allow",
      "Where-Object *": "allow",
      "Write-Output *": "allow",
      "awk *": "allow",
      "bazel aquery *": "allow",
      "bazel build *": "allow",
      "bazel info *": "allow",
      "bazel query *": "allow",
      "cargo *": "allow",
      "cat *": "allow",
      "cp *": "allow",
      "cut *": "allow",
      "date": "allow",
      "df *": "allow",
      "dir *": "allow",
      "dotnet *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "env *": "allow",
      "false": "allow",
      "file *": "allow",
      "find *": "allow",
      "find / *": "deny",
      "find {env:HOME} *": "deny",
      "free *": "allow",
      "git -c core.quotepath=false diff *": "allow",
      "git branch *": "allow",
      "git diff *": "allow",
      "git diff-tree *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git merge-base *": "allow",
      "git remote *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git show-ref *": "allow",
      "git status *": "allow",
      "git submodule status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "lstat *": "allow",
      "mkdir *": "allow",
      "mv *": "ask",
      "npm *": "allow",
      "od *": "allow",
      "python -c *": "deny",
      "python2 -c *": "deny",
      "python3 -c *": "deny",
      "read *": "allow",
      "rg *": "allow",
      "rm *": "ask",
      "ruff *": "allow",
      "rustc *": "allow",
      "rustdoc *": "allow",
      "sbt *": "allow",
      "sbt11 *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "strings *": "allow",
      "tail *": "allow",
      "tomlq *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "true": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "where *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs *": "allow",
      "xxd *": "allow",
      "yarn *": "allow",
      "yq *": "allow"
    },
    "context7_*": {
      "*": "allow"
    },
    "deepwiki_*": {
      "*": "allow"
    },
    "doom_loop": {
      "*": "deny"
    },
    "edit": {
      "*": "allow"
    },
    "excel_*": {
      "*": "allow"
    },
    "external_directory": {
      "/run/*": "allow",
      "/tmp/*": "allow",
      "{env:HOME}/.cache/*": "allow",
      "{env:HOME}/.cargo/*": "allow",
      "{env:HOME}/.dotfiles/kilo/*": "allow",
      "{env:HOME}/.dotfiles/rust/.cargo/*": "allow",
      "{env:HOME}/.dotnet/*": "allow",
      "{env:HOME}/.ivy2/*": "allow",
      "{env:HOME}/.kilo/skills/*": "allow",
      "{env:HOME}/.local/share/cargo/*": "allow",
      "{env:HOME}/.local/share/kilo/plans/*": "allow",
      "{env:HOME}/.local/share/rustup/toolchains/*": "allow",
      "{env:HOME}/.sbt/*": "allow",
      "{env:HOME}/go/*": "allow"
    },
    "ghidra_*": {
      "*": "allow"
    },
    "github_get_*": {
      "*": "allow"
    },
    "github_list_*": {
      "*": "allow"
    },
    "github_pull_request_read": {
      "*": "allow"
    },
    "github_search_*": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "kilo_memory_*": {
      "*": "allow"
    },
    "linear_get_*": {
      "*": "allow"
    },
    "linear_list_*": {
      "*": "allow"
    },
    "list": {
      "*": "allow"
    },
    "lsp": {
      "*": "allow"
    },
    "read": {
      "*": "allow",
      ".env": "deny"
    },
    "semantic_search": {
      "*": "deny"
    },
    "semble_*": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    },
    "todowrite": {
      "*": "allow"
    },
    "webfetch": {
      "*": "allow"
    },
    "websearch": {
      "*": "allow"
    },
    "windbg_*": {
      "*": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
        "X-MCP-Toolsets": "context,issues,repos,pull_requests",
        "X-MCP-Readonly": "true"
      },
      "enabled": false
    },
    "gitlab": {
      "type": "remote",
      "url": "https://gitlab.com/api/v4/mcp",
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--quiet",
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "enabled": true
    }
  }
}
