  "sandbox": {
    "enabled": true,
    "network": "allow"
  },
  "lsp": true,
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Measure-Object": "allow",
      "Select-Object *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "Where-Object *": "allow",
      "awk *": "allow",
      "cargo *": "allow",
      "cat *": "allow",
      "cp *": "allow",
      "cut *": "allow",
      "date": "allow",
      "df *": "allow",
      "dir *": "allow",
      "dotnet *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "false": "allow",
      "find *": "allow",
      "free *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "mv *": "ask",
      "npm *": "allow",
      "python -c *": "deny",
      "python2 -c *": "deny",
      "python3 -c *": "deny",
      "read *": "allow",
      "rm *": "ask",
      "ruff *": "allow",
      "rustc *": "allow",
      "rustdoc *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "strings *": "allow",
      "tail *": "allow",
      "tomlq *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "true": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "where *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs *": "allow",
      "xxd *": "allow",
      "yarn *": "allow",
      "yq *": "allow",
      "sbt11 *": "allow",
      "sbt *": "allow"
    },
    "context7_query-docs": "allow",
    "context7_resolve-library-id": "allow",
    "deepwiki_ask_question": "allow",
    "deepwiki_read_wiki_contents": "allow",
    "deepwiki_read_wiki_structure": "allow",
    "doom_loop": "deny",
    "edit": "allow",
    "exa_web_fetch_exa": "allow",
    "exa_web_search_exa": "allow",
    "glob": "allow",
    "grep": "allow",
    "kilo_memory_recall": "allow",
    "kilo_memory_save": "allow",
    "list": "allow",
    "lsp": "allow",
    "read": {
      "*": "allow",
      ".env": "deny"
    },
    "semantic_search": "allow",
    "semble_search": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "indexing": {
    "enabled": false,
    "provider": "openai-compatible",
    "model": "nomic-ai/nomic-embed-text-v1.5",
    "openai-compatible": {
      "baseUrl": "http://localhost:12434/v1",
      "apiKey": "sk-local"
    },
    "vectorStore": "lancedb",
    "dimension": 768
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": false
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "enabled": false
    }
  }
}
