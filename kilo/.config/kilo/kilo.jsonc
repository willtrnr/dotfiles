  "sandbox": {
    "enabled": true,
    "network": "allow",
    "writable_paths": [
      "~/.cache"
    ]
  },
  "lsp": true,
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Measure-Object": "allow",
      "Select-Object *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "Where-Object *": "allow",
      "awk *": "allow",
      "cargo *": "allow",
      "cat *": "allow",
      "cp *": "allow",
      "cut *": "allow",
      "date": "allow",
      "df *": "allow",
      "dir *": "allow",
      "dotnet *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "false": "allow",
      "find *": "allow",
      "free *": "allow",
      "git diff *": "allow",
      "git diff-tree *": "allow",
      "git log *": "allow",
      "git merge-base *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git show-ref *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "mv *": "ask",
      "npm *": "allow",
      "python -c *": "deny",
      "python2 -c *": "deny",
      "python3 -c *": "deny",
      "read *": "allow",
      "rg *": "allow",
      "rm *": "ask",
      "ruff *": "allow",
      "rustc *": "allow",
      "rustdoc *": "allow",
      "sbt *": "allow",
      "sbt11 *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "strings *": "allow",
      "tail *": "allow",
      "tomlq *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "true": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "where *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs *": "allow",
      "xxd *": "allow",
      "yarn *": "allow",
      "yq *": "allow"
    },
    "context7_query-docs": {
      "*": "allow"
    },
    "context7_resolve-library-id": {
      "*": "allow"
    },
    "deepwiki_ask_question": {
      "*": "allow"
    },
    "deepwiki_read_wiki_contents": {
      "*": "allow"
    },
    "deepwiki_read_wiki_structure": {
      "*": "allow"
    },
    "doom_loop": "deny",
    "edit": {
      "*": "allow"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "~/.dotfiles/kilo/*": "allow",
      "~/.kilo/skills/*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "kilo_memory_recall": {
      "*": "allow"
    },
    "kilo_memory_save": {
      "*": "allow"
    },
    "list": "allow",
    "lsp": "allow",
    "read": {
      "*": "allow",
      ".env": "deny"
    },
    "semantic_search": {
      "*": "deny"
    },
    "semble_find_related": {
      "*": "allow"
    },
    "semble_search": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "indexing": {
    "enabled": false,
    "model": "nomic-ai/nomic-embed-text-v1.5",
    "dimension": 768
  },
  "mcp": {
    "asdlc": {
      "type": "remote",
      "url": "https://asdlc.io/mcp",
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "oauth": true,
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--quiet",
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "enabled": true
    }
  }
}
