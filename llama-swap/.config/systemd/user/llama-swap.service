[Unit]
Description=llama-swap server

[Service]
Type=exec
ExecStartPre=/usr/bin/mkdir -p "${RUNTIME_DIRECTORY}/slots"
ExecStart=/usr/bin/llama-swap -config %E/llama-swap/config.yaml -listen 127.0.0.1:12434
EnvironmentFile=%E/llama-swap/env.default
EnvironmentFile=-%E/llama-swap/env
RuntimeDirectory=%N
Restart=on-failure

[Install]
WantedBy=default.target
